# Copy this file to .env (for local docker-compose) or supply values via CI secrets.
# NEVER commit a real .env file — it is in .gitignore.

# ── Docker image registry ──────────────────────────────────────────────────────
# Example: ghcr.io/your-org  or  registry.hub.docker.com/your-org
IMAGE_REGISTRY=ghcr.io/your-org
IMAGE_TAG=latest

# ── Database ──────────────────────────────────────────────────────────────────
DB_PASSWORD=change_me_strong_password

# ── Application bootstrap (first run only) ────────────────────────────────────
BOOTSTRAP_ADMIN_EMAIL=admin@your-hospital.sa
BOOTSTRAP_ADMIN_PASSWORD=Change_Me_On_First_Login!
BOOTSTRAP_TENANT_ID=HOSPITAL-001

# ── JWT signing key — generate with: openssl rand -base64 32 ─────────────────
JWT_SECRET=REPLACE_WITH_BASE64_SECRET

# ── NPHIES AES-256 master key — generate with AesEncryptionService.generateNewMasterKey()
NPHIES_MASTER_KEY_BASE64=REPLACE_WITH_BASE64_KEY

# ── TraCare clinical integration ──────────────────────────────────────────────
TRACARE_BASE_URL=http://tracare-backend:8081
TRACARE_INTERNAL_API_KEY=REPLACE_WITH_SHARED_SECRET

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
MAIL_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=no-reply@your-hospital.sa
SMTP_PASSWORD=your_smtp_app_password
MAIL_FROM=no-reply@your-hospital.sa

# ── Optional: GCP Secret Manager ──────────────────────────────────────────────
GCP_SECRET_MANAGER_ENABLED=false
GCP_PROJECT_ID=

# ── Optional: HashiCorp Vault ─────────────────────────────────────────────────
VAULT_ENABLED=false
VAULT_HOST=vault.internal
VAULT_PORT=8200
VAULT_TOKEN=

# ── Network ───────────────────────────────────────────────────────────────────
HTTP_PORT=80
